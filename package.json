{
  "name": "universal-invoice-generator",
  "version": "1.0.0",
  "description": "A flexible, international-ready invoice generation and management system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "cd webapp && npm run dev",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:frontend\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js && cd webapp && npm run build",
    "start": "npm run build && node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:reset": "tsx src/db/migrate.ts --reset",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.10.0",
    "stripe": "^22.6.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.8",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.6.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.15.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "puppeteer@25.10.0": true,
    "esbuild@0.28.2": true
  }
}
