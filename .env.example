APP_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/invoice_test
AUTH_MODE=dev
AUTH_JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For local development with `npm run dev:all`
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
# Set to your Plausible domain to enable frontend analytics (optional)
# PLAUSIBLE_DOMAIN=yourdomain.com
# GOOGLE_CALLBACK_URL is optional; when omitted it is derived from
# APP_PUBLIC_BASE_URL. In dev this becomes http://localhost:5173/...
# so the OAuth callback flows through the Vite dev-server proxy.
# Register that URL in Google Cloud Console for local development,
# and the production domain for production deployments.
GOOGLE_CALLBACK_URL=
EMAIL_FROM=noreply@example.com
EMAIL_PROVIDER=stub
# When EMAIL_PROVIDER=sendgrid, set SENDGRID_API_KEY
SENDGRID_API_KEY=
# When EMAIL_PROVIDER=ses, set AWS SES credentials
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
# When EMAIL_PROVIDER=smtp, set SMTP_* vars
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PDF_PROVIDER=html
PAYMENT_PROVIDER=stub
TAX_PROVIDER=manual
AI_PROVIDER=stub
SMS_PROVIDER=stub
# When SMS_PROVIDER=twilio, set Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Sentry error tracking (optional, set to enable)
SENTRY_DSN=
