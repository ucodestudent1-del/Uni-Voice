# =============================================================================
# Universal Invoice Generator — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in values for your environment.
# In production, set APP_ENV=production and provide real provider credentials.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---------------------------------------------------
# Required. In production, use a managed Postgres instance.
DATABASE_URL=postgresql://postgres:password@localhost:5432/universal_invoice
# Optional: separate test database (used when APP_ENV=test)
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/universal_invoice_test

# --- Redis (optional but recommended) ----------------------------------------
# Required for production rate-limiting, session revocation, PDF job queue,
# and report caching. If unset, the app falls back to in-memory stores.
REDIS_URL=redis://localhost:6379

# --- Frontend ---------------------------------------------------------------
# URL where the React/Vite frontend is served (production build)
APP_FRONTEND_URL=http://localhost:5173
# Public URL of the backend API (used for OAuth callbacks, public links)
APP_PUBLIC_BASE_URL=http://localhost:4000

# --- Authentication ----------------------------------------------------------
# "dev"   — trust x-dev-* headers (dev only, never in production)
# "jwt"   — standard JWT bearer tokens (default in production)
# "stub"  — stub auth for local testing without real login
AUTH_MODE=dev
# MUST be changed to a secure random value in production if AUTH_MODE=jwt
AUTH_JWT_SECRET=dev-secret-change-me

# --- Email (choose one provider) ---------------------------------------------
# Options: stub | smtp | sendgrid | ses
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@example.com
# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# SendGrid (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
# AWS SES (when EMAIL_PROVIDER=ses)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1

# --- SMS (optional) ----------------------------------------------------------
# Options: stub | twilio
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- PDF Generation ----------------------------------------------------------
# Options: html (puppeteer-based) | stub
PDF_PROVIDER=html

# --- Payments (choose one) ---------------------------------------------------
# Options: stub | stripe | paypal
PAYMENT_PROVIDER=stub
# Stripe (when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Tax Calculation ---------------------------------------------------------
# Options: manual | avalara | taxjar
TAX_PROVIDER=manual
# Avalara (when TAX_PROVIDER=avalara)
AVALARA_API_KEY=
AVALARA_ACCOUNT_ID=
AVALARA_ENVIRONMENT=development
# TaxJar (when TAX_PROVIDER=taxjar)
TAXJAR_API_KEY=

# --- AI Service (optional) --------------------------------------------------
# Options: stub | openai | anthropic
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OAuth (Google) ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Sentry (optional, for error tracking) ----------------------------------
SENTRY_DSN=

# --- Railway (auto-set by Railway platform) ---------------------------------
RAILWAY_PUBLIC_DOMAIN=
