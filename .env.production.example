# =============================================================================
# Universal Invoice Generator — Production Environment Configuration
# =============================================================================
# Copy this file to `.env.production` and fill in real values for your
# production environment before running `docker compose up --build`.
#
# In Docker, the hostnames `db` and `redis` refer to the Docker Compose
# services defined in docker-compose.yml.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production
PORT=4000

# --- Database (PostgreSQL) ---------------------------------------------------
# In Docker, use the service name `db` as the host.
DATABASE_URL=postgresql://postgres:password@db:5432/universal_invoice
DATABASE_URL_TEST=postgresql://postgres:password@db:5432/universal_invoice_test

# --- Redis -------------------------------------------------------------------
# Required in production for rate-limiting, session revocation, PDF job queue,
# and report caching. The app will not start without it.
REDIS_URL=redis://redis:6379

# --- Frontend ---------------------------------------------------------------
# URL where the React/Vite frontend is served (production build served by API)
# IMPORTANT: Must be HTTPS and non-localhost in production (enforced by zod schema)
APP_FRONTEND_URL=https://yourdomain.com
# Public URL of the backend API (used for OAuth callbacks, public links)
# IMPORTANT: Must be HTTPS and non-localhost in production (enforced by zod schema)
APP_PUBLIC_BASE_URL=https://yourdomain.com

# --- Authentication ----------------------------------------------------------
# In production: must be "jwt" (dev and stub are blocked).
AUTH_MODE=jwt
# MUST be changed to a secure random value in production.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=<< replace with `openssl rand -hex 32` >>

# --- Email (choose one provider) ---------------------------------------------
# In production, stub is blocked — must use a real provider.
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@yourdomain.com
# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SendGrid (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
# AWS SES (when EMAIL_PROVIDER=ses)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1

# --- SMS (optional) ----------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- PDF Generation ----------------------------------------------------------
PDF_PROVIDER=html

# --- Payments (choose one) ---------------------------------------------------
# In production, stub is blocked — must use stripe or paypal with real credentials.
PAYMENT_PROVIDER=stripe
# Stripe (when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (when PAYMENT_PROVIDER=paypal)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_ENVIRONMENT=live

# --- Tax Calculation ---------------------------------------------------------
TAX_PROVIDER=manual
AVALARA_API_KEY=
AVALARA_ACCOUNT_ID=
AVALARA_ENVIRONMENT=production
TAXJAR_API_KEY=

# --- AI Service (optional) --------------------------------------------------
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Multi-Currency (optional) ----------------------------------------------
FX_API_PROVIDER=openexchangerates
FX_API_KEY=
FX_BASE_CURRENCY=USD
APP_DEFAULT_CURRENCY=USD

# --- OAuth (Google) ----------------------------------------------------------
# IMPORTANT: Must be HTTPS in production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# --- Sentry (optional, for error tracking) ----------------------------------
SENTRY_DSN=

# --- Railway (auto-set by Railway platform) ---------------------------------
RAILWAY_PUBLIC_DOMAIN=
