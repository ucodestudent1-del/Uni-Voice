APP_ENV=development
PORT=4000
# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/invoice_test
# --- Auth (dev stub: set to "dev" to enable a permissive dev auth that trusts X-User-Id / X-Business-Id headers) ---
AUTH_MODE=dev
AUTH_JWT_SECRET=dev-secret-change-me
# --- Public URL (used for generating public invoice links in emails) ---
APP_PUBLIC_BASE_URL=http://localhost:4000
# --- Email ---
EMAIL_FROM=noreply@example.com
EMAIL_PROVIDER=stub
# --- PDF ---
PDF_PROVIDER=html
# --- Payments (future) ---
PAYMENT_PROVIDER=stub
# --- Tax (future automated providers) ---
TAX_PROVIDER=manual
# --- AI (future) ---
AI_PROVIDER=stub
